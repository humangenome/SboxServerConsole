# Example systemd unit for SboxServerConsole on Linux.
#
# Install:
#   sudo cp examples/sboxserverconsole.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sboxserverconsole
#
# Edit User=, ExecStart=, and WorkingDirectory= to match your install before
# enabling the unit. KillMode=mixed ensures systemd reaps any orphaned
# sbox-server children if the wrapper itself is killed hard (SIGKILL).
[Unit]
Description=SboxServerConsole (process agent for the s&box dedicated server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sbox
Group=sbox
WorkingDirectory=/opt/sbox-server
ExecStart=/opt/sbox-server/SboxServerConsole --config-file /opt/sbox-server/sboxconsole.json
Restart=on-failure
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

# Hardening. ProtectSystem=strict makes everything read-only except the paths
# listed in ReadWritePaths, so list every directory your config writes to (the
# server folder, plus the audit log, banlist, allowlist and scheduler folders).
# Home directories stay readable because the s&box server can load the Steam
# client library from ~/.steam/sdk64.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/sbox-server /var/log/sboxconsole /var/lib/sboxconsole

[Install]
WantedBy=multi-user.target
