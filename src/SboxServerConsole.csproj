<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SboxServerConsole</RootNamespace>
    <AssemblyName>SboxServerConsole</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.4.0</Version>
    <Authors>HumanGenome</Authors>
    <Description>Cross-platform process agent for the s&amp;box dedicated server. Source RCON TCP listener, HTTP+SSE console, A2S player tracking, banlist + allowlist enforcement, scheduled commands, lifecycle control, auto-restart, audit log, Discord notifications, web dashboard. Windows + Linux.</Description>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.8.4" />
    <!-- ServiceBase, for running under the Windows service manager (Windows only). -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="web/index.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SboxServerConsole.Tests" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Text.Json.JsonSerializer.IsReflectionEnabledByDefault" Value="true" />
  </ItemGroup>

</Project>
